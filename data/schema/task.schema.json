{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bharatbench.local/schema/task.schema.json",
  "title": "BharatBench task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "category", "prompt", "language", "answer_type",
    "reference_answer", "difficulty", "verified"
  ],
  "anyOf": [
    {"required": ["worked_solution"]},
    {"required": ["source_url"]}
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^(gst|hin|doc|law|pay)-[0-9]{3}$"},
    "category": {
      "enum": ["gst_tax", "hinglish_support", "documents", "law_policy", "payments_banking"]
    },
    "prompt": {"type": "string", "minLength": 1},
    "language": {"enum": ["en", "hi", "hinglish"]},
    "answer_type": {"enum": ["exact", "numeric", "extraction", "rubric"]},
    "reference_answer": {
      "description": "numeric: number. exact: string. extraction: object of field -> string/number. rubric: non-empty array of criteria strings.",
      "oneOf": [
        {"type": "number"},
        {"type": "string", "minLength": 1},
        {"type": "object", "minProperties": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "tolerance": {"type": "number", "minimum": 0},
    "worked_solution": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "pattern": "^https://"},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "verified": {"type": "boolean"}
  }
}
